{
  "expo": {
    "name": "PredictX",
    "slug": "ipl-iq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "predictx",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F9FB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.insideedge.cricvora",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PredictX uses your photo library to set your profile picture.",
        "NSCameraUsageDescription": "PredictX uses the camera to capture your profile picture."
      }
    },
    "newArchEnabled": true,
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F9FB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.insideedge.cricvora",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "PredictX uses your photo library to set your profile picture.",
          "cameraPermission": "PredictX uses the camera to capture your profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a16f9d8d-dba4-4017-bdfd-9a2b4cd832a0"
      }
    },
    "owner": "aviiishk"
  }
}
